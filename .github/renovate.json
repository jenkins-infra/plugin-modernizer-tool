{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jenkinsci/renovate-config"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Plugin Modernizer release version",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";"],
      "depNameTemplate": "jenkins-infra/plugin-modernizer-tool",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update macOS ARM64 release hash",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";[\\s\\S]*?isDarwin\\n              then \"sha256:(?<currentDigest>[a-f0-9]{64})\"\\n              else if pkgs\\.stdenv\\.hostPlatform\\.isAarch64"],
      "depNameTemplate": "jenkins-infra/plugin-modernizer-tool",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Linux ARM64 release hash",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";[\\s\\S]*?isAarch64\\n              then \"sha256:(?<currentDigest>[a-f0-9]{64})\"\\n              else \""],
      "depNameTemplate": "jenkins-infra/plugin-modernizer-tool",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Linux x86_64 release hash",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";[\\s\\S]*?else \"sha256:(?<currentDigest>[a-f0-9]{64})\""],
      "depNameTemplate": "jenkins-infra/plugin-modernizer-tool",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Temurin JDK in .sdkmanrc",
      "managerFilePatterns": ["/(^|/)\\.sdkmanrc$/"],
      "matchStrings": ["java=(?<currentValue>\\d+(?:\\.\\d+)*)-tem"],
      "depNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "extractVersionTemplate": "^(?<version>\\d+(?:\\.\\d+)*)"
    },
    {
      "customType": "regex",
      "description": "Update Maven in .sdkmanrc",
      "managerFilePatterns": ["/(^|/)\\.sdkmanrc$/"],
      "matchStrings": ["maven=(?<currentValue>\\S+)"],
      "depNameTemplate": "org.apache.maven:apache-maven",
      "datasourceTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["jenkins-infra/plugin-modernizer-tool"],
      "groupName": "Plugin Modernizer"
    },
    {
      "description": "Only Java LTS releases (every 4th major after 21)",
      "matchDatasources": ["java-version"],
      "matchPackageNames": ["java-jdk"],
      "allowedVersions": "/^(25|29|33|37)\\./"
    },
    {
      "matchPackageNames": ["net.bytebuddy:byte-buddy", "net.bytebuddy:byte-buddy-agent"],
      "ignoredVersions": ["/.*-jdk5(?:$|[-.]).*/"]
    },
    {
      "matchPackageNames": "io.jenkins.plugin-modernizer:plugin-modernizer-pom",
      "enabled": false
    },
    {
      "matchFileNames": ["**/src/test/resources/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/jakarta.inject.*/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/com.fasterxml.jackson.*/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/org.junit.*/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/org.jenkins.*/"],
      "enabled": false
    }
  ]
}
