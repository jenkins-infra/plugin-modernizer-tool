{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jenkinsci/renovate-config"
  ],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "version = \"(?<currentValue>[^\"]+)\";[\\s\\S]*?hash = \"(?<currentDigest>[a-f0-9]{64})\";"
      ],
      "depNameTemplate": "jenkins-infra/plugin-modernizer-tool",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": "io.jenkins.plugin-modernizer:plugin-modernizer-pom",
      "enabled": false
    },
    {
      "matchFileNames": ["**/src/test/resources/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/jakarta.inject.*/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/com.fasterxml.jackson.*/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/org.junit.*/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/org.jenkins.*/"],
      "enabled": false
    }
  ]
}
